generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

///////////////////////////
// ENUMS
///////////////////////////

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebinarType {
  FREE
  PAID
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

///////////////////////////
// USER & AUTH
///////////////////////////

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  googleId       String?   @unique
  name           String?
  profilePicture String?
  provider       String    @default("local") // "local" or "google"
  role           Role      @default(MENTEE)
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  mentorProfile        MentorProfile?
  menteeProfile        MenteeProfile?
  adminProfile         AdminProfile?
  mentorApplications   MentorApplication[]
  verification         VerificationDocument?

  @@index([role])
  @@index([email])
}

///////////////////////////
// VERIFICATION DOCUMENTS
///////////////////////////

model VerificationDocument {
  id          String             @id @default(uuid())
  userId      String             @unique
  documentUrl String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])
}

///////////////////////////
// MENTOR PROFILE
///////////////////////////
model MentorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  bio                String
  headline           String?
  expertise          String[]
  certifications     String[]
  rating             Float              @default(0)
  totalReviews       Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBadge      Boolean            @default(false)

  // Personal Details
  phone           String?
  gender          Gender?
  location        String?
  socialLinks     Json? // [{platform: string, url: string}]
  verificationIds String[] // IDs for verification documents

  // Education
  bachelors String[] // [degree, instituteName, score, yearOfPassout]
  masters   String[] // [degree, instituteName, score, yearOfPassout]

  // Work Experience (JSON array)
  workExperience Json? // [{company, companyType, startDate, endDate, description}]

  // Exam Scores (JSON array)
  exams Json? // [{examName, score, year}]

  // Earnings
  balance         Float @default(0) // Current withdrawable balance
  totalEarnings   Float @default(0) // Lifetime earnings
  pendingEarnings Float @default(0) // Earnings pending clearance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  services      Service[]
  feedbackGiven MentorFeedback[]
  resumes       MentorResume[]

  @@index([rating])
}

///////////////////////////
// MENTEE PROFILE
///////////////////////////

model MenteeProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  dob            DateTime?
  phone          String?
  location       String?
  gender         Gender?
  bachelors      String[]
  masters        String[]
  workExperience String?
  certifications String[]
  catAttempts    Json? // [{year, score, percentile}]
  expectations   String?
  targetColleges String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  resumes MenteeResume[]
}

///////////////////////////
// ADMIN PROFILE
///////////////////////////

model AdminProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

///////////////////////////
// MENTOR APPLICATIONS
///////////////////////////

model MentorApplication {
  id     String @id @default(uuid())
  userId String

  // Step 1: Personal Details & Social Links
  bio             String
  headline        String?
  phone           String?
  gender          Gender?
  location        String?
  socialLinks     Json? // [{platform: string, url: string}] max 5
  verificationIds String[] // IDs for verification documents

  // Step 2: Expertise
  expertise String[]

  // Step 3: Education
  bachelors String[] // [degree, instituteName, score, yearOfPassout]
  masters   String[] // [degree, instituteName, score, yearOfPassout]

  // Step 4: Work Experience
  workExperience Json? // [{company, role, startDate, endDate, description}]

  // Step 5: Exam Scores
  exams Json? // [{examName, score, year, percentile}]

  // Step 6: Certifications
  certifications String[]

  // Step 7: Resumes
  resumes Json? // [{name, fileUrl}]

  // Application Status
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String? // Admin user ID who reviewed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

///////////////////////////
// DOCUMENTS
///////////////////////////

model MenteeResume {
  id        String   @id @default(uuid())
  menteeId  String
  name      String
  fileUrl   String
  createdAt DateTime @default(now())

  mentee MenteeProfile @relation(fields: [menteeId], references: [id])
}

model MentorResume {
  id        String   @id @default(uuid())
  mentorId  String
  name      String
  fileUrl   String
  createdAt DateTime @default(now())

  mentor MentorProfile @relation(fields: [mentorId], references: [id])

  @@index([mentorId])
}

///////////////////////////
// MENTOR SERVICES
///////////////////////////

model Service {
  id               String        @id @default(uuid())
  mentorId         String
  title            String
  shortDescription String
  longDescription  String? // Optional detailed description
  price            Float
  duration         Int // Duration in minutes
  status           ServiceStatus @default(DRAFT)

  // Analytics & Tracking
  totalBookings Int   @default(0)
  totalRevenue  Float @default(0)
  averageRating Float @default(0)
  totalReviews  Int   @default(0)
  viewCount     Int   @default(0) // How many times service was viewed

  // Metadata
  tags      String[] // For categorization and search
  category  String? // Main category
  isPopular Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor  MentorProfile   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  reviews ServiceReview[]

  @@index([mentorId])
  @@index([status])
  @@index([category])
  @@index([isPopular])
}

///////////////////////////
// SERVICE REVIEWS
///////////////////////////

model ServiceReview {
  id         String   @id @default(uuid())
  serviceId  String
  menteeId   String // User ID who left the review
  menteeName String // Name at time of review
  rating     Int
  comment    String?
  isVerified Boolean  @default(false) // Whether booking was actually completed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([menteeId])
}

///////////////////////////
// MENTOR FEEDBACK (General)
///////////////////////////

model MentorFeedback {
  id             String   @id @default(uuid())
  mentorId       String
  sessionId      String? // Reference to external session/booking system if needed
  feedbackPdfUrl String?
  notes          String? // General notes about the feedback
  createdAt      DateTime @default(now())

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

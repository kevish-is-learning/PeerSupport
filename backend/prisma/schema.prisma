generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MentorServiceType {
  SOP_REVIEW
  RESUME_CURATION
  MOCK_INTERVIEW
  WAT_GD_PREP
  KNOW_YOUR_COLLEGE
  ONE_ON_ONE_CONNECT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SessionType {
  ONE_ON_ONE
  GROUP_DISCUSSION
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  googleId String? @unique

  provider AuthProvider @default(LOCAL)

  role Role @default(MENTEE)

  name String

  profilePicture String?

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?

  menteeBookings Booking[] @relation("MenteeBookings")

  reviewsGiven Review[] @relation("ReviewAuthor")

  @@index([email])
  @@index([role])
}

// ============================================================
// MENTEE PROFILE
// ============================================================

model MenteeProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  dateOfBirth DateTime @db.Date

  contactNumber String

  education Json

  catHistory Json?

  otherMbaScore Float?

  workExperience String?

  certifications String?

  expectations String?

  skillsets String[]

  resumeUrl String?

  linkedInUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}


// ============================================================
// MENTOR PROFILE
// ============================================================

model MentorProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  bio String

  linkedInUrl String?

  contactNumber String

  expertiseTags String[]

  ugCollegeProfile String?

  pgCollegeProfile String?

  workExperience String?

  certifications String?

  collegeDocumentUrl String?

  approvalStatus MentorApprovalStatus @default(PENDING)

  isVerified Boolean @default(false)

  totalSessions Int @default(0)

  totalEarnings Float @default(0)

  averageRating Float @default(0)

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services MentorService[]

  weeklyAvailability WeeklyAvailability[]

  mentorBookings Booking[] @relation("MentorBookings")

  reviews Review[]

  feedbacks SessionFeedback[]

  payouts Payout[]

  @@index([approvalStatus])
  @@index([averageRating])
  @@index([username])
}

// ============================================================
// MENTOR SERVICES
// ============================================================

model MentorService {
  id String @id @default(uuid())

  mentorProfileId String

  serviceType MentorServiceType

  description String?

  durationMinutes Int

  pricePerSession Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  // Many-to-many: which slots offer this service
  slotServices SlotService[]

  bookings Booking[]

  @@unique([mentorProfileId, serviceType])
  @@index([mentorProfileId])
}

// ============================================================
// AVAILABILITY (NEW ARCHITECTURE)
// ============================================================

/// WeeklyAvailability: Day-level container.
/// One record per mentor per day-of-week.
model WeeklyAvailability {
  id String @id @default(uuid())

  mentorProfileId String

  dayOfWeek DayOfWeek

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  // Child slots within this day
  slots AvailabilitySlot[]

  @@unique([mentorProfileId, dayOfWeek])
}

/// AvailabilitySlot: A time range within a day.
/// Uses DateTime for startTime/endTime (date portion is canonical 1970-01-01).
/// maxBookings controls capacity (1 = 1:1, >1 = group sessions).
model AvailabilitySlot {
  id String @id @default(uuid())

  weeklyAvailabilityId String

  /// Time stored as DateTime; date portion is always 1970-01-01.
  /// Only the time component (HH:mm) matters.
  startTime DateTime
  endTime   DateTime

  /// Maximum concurrent bookings for this slot.
  /// 1 = one-on-one only. >1 = supports group sessions.
  maxBookings Int @default(1)

  /// Soft-disable without deletion.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  // Many-to-many: which services are offered in this slot
  slotServices SlotService[]

  // Bookings placed against this slot
  bookings Booking[]

  @@index([weeklyAvailabilityId])
}

/// SlotService: Join table between AvailabilitySlot and MentorService.
/// This is the core architectural fix: each slot explicitly declares
/// which services it supports.
model SlotService {
  id String @id @default(uuid())

  availabilitySlotId String
  mentorServiceId    String

  createdAt DateTime @default(now())

  availabilitySlot AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Cascade)
  mentorService    MentorService    @relation(fields: [mentorServiceId], references: [id], onDelete: Cascade)

  @@unique([availabilitySlotId, mentorServiceId])
  @@index([mentorServiceId])
}

// ============================================================
// BOOKINGS (UPDATED)
// ============================================================

model Booking {
  id String @id @default(uuid())

  menteeId String

  mentorProfileId String

  mentorServiceId String

  /// Required: every booking must be tied to a specific slot.
  availabilitySlotId String

  /// The actual calendar date this booking is for (e.g., 2026-05-15).
  /// Combined with the slot's time range, this gives the full datetime.
  scheduledDate DateTime @db.Date

  sessionType SessionType @default(ONE_ON_ONE)

  bookingStatus BookingStatus @default(PENDING)

  /// Resolved start/end times for this specific booking instance.
  /// Computed from slot time + scheduledDate on creation.
  startTime DateTime
  endTime   DateTime

  meetingLink String?

  purposeOfCall String?

  notes String?

  sharedResume Boolean @default(false)

  isFeedbackSubmitted Boolean @default(false)

  cancelledReason String?

  rescheduledFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee User @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation("MentorBookings", fields: [mentorProfileId], references: [id], onDelete: Cascade)

  mentorService MentorService @relation(fields: [mentorServiceId], references: [id])

  availabilitySlot AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id])

  payment Payment?

  review Review?

  feedback SessionFeedback?

  // Prevent same mentee from booking same slot on same date twice
  @@unique([menteeId, availabilitySlotId, scheduledDate])
  @@index([menteeId])
  @@index([mentorProfileId])
  @@index([bookingStatus])
  @@index([startTime])
  @@index([availabilitySlotId, scheduledDate])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid())

  bookingId String @unique

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  amount Float

  currency String @default("INR")

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  refundedAmount Float?

  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoice Invoice?
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  paymentId String @unique

  invoiceNumber String @unique

  invoiceUrl String?

  generatedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================
// SESSION FEEDBACK
// ============================================================

model SessionFeedback {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  strengths String?

  weaknesses String?

  recommendations String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  authorId String

  rating Int

  review String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
}

// ============================================================
// PAYOUTS
// ============================================================

model Payout {
  id String @id @default(uuid())

  mentorProfileId String

  amount Float

  transactionId String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

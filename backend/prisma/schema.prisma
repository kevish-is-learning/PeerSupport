generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MentorServiceType {
  SOP_REVIEW
  RESUME_CURATION
  MOCK_INTERVIEW
  WAT_GD_PREP
  KNOW_YOUR_COLLEGE
  ONE_ON_ONE_CONNECT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SessionType {
  ONE_ON_ONE
  GROUP_DISCUSSION
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  googleId String? @unique

  provider AuthProvider @default(LOCAL)

  role Role @default(MENTEE)

  name String

  profilePicture String?

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?

  menteeBookings Booking[] @relation("MenteeBookings")

  reviewsGiven Review[] @relation("ReviewAuthor")

  @@index([email])
  @@index([role])
}

// ============================================================
// MENTEE PROFILE
// ============================================================

model MenteeProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  dateOfBirth DateTime @db.Date

  contactNumber String

  education Json

  catScore Float?

  otherExamScore Float?

  workExperience String?

  certifications String?

  expectations String?

  skillsets String[]

  resumeUrl String?

  linkedInUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

// ============================================================
// MENTOR PROFILE
// ============================================================

model MentorProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  bio String

  linkedInUrl String?

  contactNumber String

  expertiseTags String[]

  ugCollegeProfile String?

  pgCollegeProfile String?

  workExperience String?

  certifications String?

  collegeDocumentUrl String?

  approvalStatus MentorApprovalStatus @default(PENDING)

  isVerified Boolean @default(false)

  totalSessions Int @default(0)

  totalEarnings Float @default(0)

  averageRating Float @default(0)

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services MentorService[]

  weeklyAvailability WeeklyAvailability[]

  mentorBookings Booking[] @relation("MentorBookings")

  reviews Review[]

  feedbacks SessionFeedback[]

  payouts Payout[]

  @@index([approvalStatus])
  @@index([averageRating])
  @@index([username])
}

// ============================================================
// MENTOR SERVICES
// ============================================================

model MentorService {
  id String @id @default(uuid())

  mentorProfileId String

  serviceType MentorServiceType

  description String?

  durationMinutes Int

  pricePerSession Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@unique([mentorProfileId, serviceType])
  @@index([mentorProfileId])
}

// ============================================================
// AVAILABILITY
// ============================================================

model WeeklyAvailability {
  id String @id @default(uuid())

  mentorProfileId String

  dayOfWeek DayOfWeek

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  timeSlots TimeSlot[]

  @@unique([mentorProfileId, dayOfWeek])
}

model TimeSlot {
  id String @id @default(uuid())

  weeklyAvailabilityId String

  startTime String
  endTime   String

  maxBookings Int @default(1)

  createdAt DateTime @default(now())

  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([weeklyAvailabilityId])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id String @id @default(uuid())

  menteeId String

  mentorProfileId String

  mentorServiceId String

  timeSlotId String?

  sessionType SessionType @default(ONE_ON_ONE)

  bookingStatus BookingStatus @default(PENDING)

  startTime DateTime
  endTime   DateTime

  meetingLink String?

  purposeOfCall String?

  notes String?

  sharedResume Boolean @default(false)

  isFeedbackSubmitted Boolean @default(false)

  cancelledReason String?

  rescheduledFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee User @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation("MentorBookings", fields: [mentorProfileId], references: [id], onDelete: Cascade)

  mentorService MentorService @relation(fields: [mentorServiceId], references: [id])

  timeSlot TimeSlot? @relation(fields: [timeSlotId], references: [id])

  payment Payment?

  review Review?

  feedback SessionFeedback?

  @@index([menteeId])
  @@index([mentorProfileId])
  @@index([bookingStatus])
  @@index([startTime])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid())

  bookingId String @unique

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  amount Float

  currency String @default("INR")

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  refundedAmount Float?

  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoice Invoice?
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  paymentId String @unique

  invoiceNumber String @unique

  invoiceUrl String?

  generatedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================
// SESSION FEEDBACK
// ============================================================

model SessionFeedback {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  strengths String?

  weaknesses String?

  recommendations String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  authorId String

  rating Int

  review String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
}

// ============================================================
// PAYOUTS
// ============================================================

model Payout {
  id String @id @default(uuid())

  mentorProfileId String

  amount Float

  transactionId String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

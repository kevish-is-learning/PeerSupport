generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PAYMENT_PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  RESCHEDULE_REQUESTED
  RESCHEDULE_ACCEPTED
  RESCHEDULE_REJECTED
  CANCELLED_BY_MENTOR
  CANCELLED_BY_MENTEE
  NO_SHOW_MENTOR
  NO_SHOW_MENTEE
  REFUND_INITIATED
  REFUND_COMPLETED
}

enum VerificationCallStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WalletTransactionType {
  EARNING
  REFUND_DEBIT
  PENALTY
  PAYOUT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  googleId String? @unique

  provider AuthProvider @default(LOCAL)

  role Role @default(MENTEE)

  name String

  profilePicture String?

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?

  menteeBookings Booking[] @relation("MenteeBookings")

  reviewsGiven Review[] @relation("ReviewAuthor")

  scheduledVerificationCalls MentorVerificationCall[] @relation("ScheduledVerificationCalls")

  packagePurchases     PackagePurchase[]              @relation("MenteePackagePurchases")
  webinarRegistrations WebinarRegistration[]          @relation("WebinarRegistrations")
  gdRegistrations      GroupDiscussionRegistration[]  @relation("GroupDiscussionRegistrations")
  blogPosts            BlogPost[]                     @relation("BlogAuthor")
  supportTickets       SupportTicket[]                @relation("SupportTickets")
  supportMessages      SupportTicketMessage[]         @relation("SupportTicketMessages")

  @@index([email])
  @@index([role])
}

// ============================================================
// MENTEE PROFILE
// ============================================================

model MenteeProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  dateOfBirth DateTime @db.Date

  contactNumber String

  education Json

  catHistory Json?

  otherMbaTest Json?

  workExperience String?

  certifications String?

  expectations String?

  skillsets String[]

  resumeUrl String?

  linkedInUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents MenteeDocument[]

  @@index([username])
}


// ============================================================
// MENTOR PROFILE
// ============================================================

model MentorProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  bio String

  linkedInUrl String?

  contactNumber String

  expertiseTags String[]

  ugCollegeProfile String?

  pgCollegeProfile String?

  workExperience String?

  certifications String?

  collegeDocumentUrl String?

  /// Structured application data; legacy text fields are retained for existing profiles.
  education Json?
  professionalExperience Json?

  /// JSON blob storing "Why I Want to Mentor" Q&A answers
  mentoringQA Json?

  approvalStatus MentorApprovalStatus @default(PENDING)

  adminReviewNotes String?
  reviewedAt DateTime?

  isVerified Boolean @default(false)

  totalSessions Int @default(0)

  totalEarnings Float @default(0)

  averageRating Float @default(0)

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mentorServices      MentorService[]
  availabilityWindows AvailabilityWindow[]
  mentorBookings      Booking[]  @relation("MentorBookings")
  reviews             Review[]
  feedbacks           SessionFeedback[]
  payouts             Payout[]
  wallet              MentorWallet?
  cancellationStat    MentorCancellationStat?
  verificationCalls   MentorVerificationCall[]
  sessionPackages     SessionPackage[]
  hostedWebinars      Webinar[]
  moderatedDiscussions GroupDiscussion[]

  @@index([approvalStatus])
  @@index([averageRating])
  @@index([username])
}

// ============================================================
// MENTOR SERVICES
// ============================================================

/// Links a mentor to a service with pricing and duration config.
/// Supports both catalogue-based (serviceId set) and custom (title set) services.
model MentorService {
  id String @id @default(uuid())

  mentorProfileId String

  /// Custom service title (used when serviceId is null, or as override)
  title           String?
  /// Custom service description
  description     String?

  /// Price in INR (₹50 – ₹2000)
  price           Float
  /// Session duration: 15, 30, 45, or 60 minutes
  durationMinutes Int
  /// Buffer between consecutive slots: 0, 5, 10, or 15 minutes
  bufferMinutes   Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  windowServices AvailabilityWindowService[]
  bookings       Booking[]
  packages       SessionPackage[]

  @@index([mentorProfileId])
}

// ============================================================
// AVAILABILITY WINDOWS (replaces WeeklyAvailability + AvailabilitySlot)
// ============================================================

/// A time range during which a mentor is available.
/// Can be recurring (dayOfWeek set, specificDate null) or
/// one-off (specificDate set, dayOfWeek null).
model AvailabilityWindow {
  id String @id @default(uuid())

  mentorProfileId String

  /// For recurring windows — e.g., every MONDAY
  dayOfWeek DayOfWeek?

  /// For one-off overrides — e.g., 2026-05-15
  specificDate DateTime? @db.Date

  /// Start time (stored as HH:mm in canonical 1970-01-01 UTC)
  startTime DateTime
  /// End time (stored as HH:mm in canonical 1970-01-01 UTC)
  endTime   DateTime

  /// IANA timezone (default IST)
  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile  MentorProfile              @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  windowServices AvailabilityWindowService[]

  @@index([mentorProfileId])
  @@index([mentorProfileId, dayOfWeek])
  @@index([mentorProfileId, specificDate])
}

// ============================================================
// AVAILABILITY WINDOW ↔ MENTOR SERVICE (join table)
// ============================================================

/// Which services are offered during a specific availability window.
model AvailabilityWindowService {
  id String @id @default(uuid())

  windowId        String
  mentorServiceId String

  createdAt DateTime @default(now())

  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  mentorService MentorService      @relation(fields: [mentorServiceId], references: [id], onDelete: Cascade)

  @@unique([windowId, mentorServiceId])
  @@index([mentorServiceId])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id String @id @default(uuid())

  menteeId        String
  mentorProfileId String
  mentorServiceId String

  /// Resolved UTC start/end — the actual booked time.
  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(PAYMENT_PENDING)

  /// Razorpay payment ID (nullable — set on payment confirmation)
  paymentId String?

  meetingLink String?

  purposeOfCall String?

  notes String?

  /// Contact info collected during booking
  menteePhone String?
  menteeEmail String?

  /// What the mentee wants to discuss
  discussionTopic String?

  /// Specific questions for the mentor
  specificQuestions String?

  cancelledReason String?

  /// Who cancelled this booking (userId)
  cancelledBy String?

  /// Parent booking ID for reschedule chain
  parentBookingId String?

  rescheduledFromId String?

  /// Set when this booking was redeemed from a purchased package
  packagePurchaseId String?

  /// Mentee chose to share their profile with the mentor
  shareProfile Boolean @default(false)

  /// Earlier booking whose feedback the mentee chose to resurface for the mentor
  sharedFeedbackBookingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee        User          @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation("MentorBookings", fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorService MentorService @relation(fields: [mentorServiceId], references: [id])

  payment  Payment?
  review   Review?
  feedback SessionFeedback?

  /// Self-referential relation for reschedule chain
  parentBooking       Booking?  @relation("RescheduledBookings", fields: [parentBookingId], references: [id])
  rescheduledBookings Booking[] @relation("RescheduledBookings")

  attendance SessionAttendance?

  packagePurchase PackagePurchase? @relation(fields: [packagePurchaseId], references: [id], onDelete: SetNull)

  sharedDocuments BookingSharedDocument[]

  @@index([packagePurchaseId])
  @@index([menteeId])
  @@index([mentorProfileId])
  @@index([status])
  @@index([parentBookingId])
  // Composite index for conflict-check queries
  @@index([mentorProfileId, startTime, endTime])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid())

  bookingId String @unique

  razorpayOrderId   String?
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount Float

  /// Platform fee deducted (13%)
  platformFee Float @default(0)

  /// Mentor's net earning (87%)
  mentorAmount Float @default(0)

  currency String @default("INR")

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  refundedAmount Float?

  refundReason String?

  /// Razorpay refund ID
  razorpayRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoice Invoice?
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  paymentId String @unique

  invoiceNumber String @unique

  invoiceUrl String?

  generatedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================
// SESSION FEEDBACK
// ============================================================

model SessionFeedback {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  strengths String?

  weaknesses String?

  recommendations String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  authorId String

  rating Int

  review String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
}

// ============================================================
// SESSION ATTENDANCE
// ============================================================

model SessionAttendance {
  id String @id @default(uuid())

  bookingId String @unique

  mentorJoinedAt  DateTime?
  mentorLeftAt    DateTime?
  menteeJoinedAt  DateTime?
  menteeLeftAt    DateTime?
  mentorFinishedAt DateTime?
  menteeFinishedAt DateTime?

  /// Duration in seconds each participant was present
  mentorDurationSecs Int @default(0)
  menteeDurationSecs Int @default(0)

  /// Number of reconnections
  mentorReconnects Int @default(0)
  menteeReconnects Int @default(0)

  /// Whether each participant was present for meaningful duration
  mentorPresent      Boolean @default(false)
  menteePresent      Boolean @default(false)

  /// Whether the session met minimum 15-minute requirement
  minimumDurationMet Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ============================================================
// MENTOR WALLET
// ============================================================

model MentorWallet {
  id String @id @default(uuid())

  mentorProfileId String @unique

  /// Earnings from completed sessions not yet released
  pendingBalance Float @default(0)

  /// Earnings available for payout
  availableBalance Float @default(0)

  /// Total amount already withdrawn
  withdrawnBalance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
}

// ============================================================
// WALLET TRANSACTIONS (immutable ledger)
// ============================================================

model WalletTransaction {
  id String @id @default(uuid())

  walletId  String
  bookingId String?

  type WalletTransactionType

  amount Float

  description String?

  /// Unique event key for idempotent balance mutations.
  idempotencyKey String? @unique

  /// Balance snapshots for audit trail
  balanceBefore Float
  balanceAfter  Float

  createdAt DateTime @default(now())

  wallet MentorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([bookingId])
  @@index([type])
}

// ============================================================
// MENTOR CANCELLATION STATS
// ============================================================

model MentorCancellationStat {
  id String @id @default(uuid())

  mentorProfileId String @unique

  /// Calendar year for counting
  year Int

  /// Number of cancellations in this year
  cancellationCount Int @default(0)

  /// Timestamp of last cancellation
  lastCancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYOUTS
// ============================================================

model Payout {
  id String @id @default(uuid())

  mentorProfileId String

  /// Gross amount requested
  amount Float

  /// Platform fee at time of payout
  platformFee Float @default(0)

  /// Net amount after platform fee
  netAmount Float

  status PayoutStatus @default(REQUESTED)

  /// How the payout was processed (e.g., "bank_transfer", "upi")
  payoutMethod String?

  /// External reference (bank transaction ID, UTR, etc.)
  transactionRef String?

  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  processedAt DateTime?

  /// Reason if payout failed
  failedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
  @@index([status])
}

// ============================================================
// MENTOR VERIFICATION CALLS
// ============================================================

model MentorVerificationCall {
  id              String  @id @default(uuid())

  mentorProfileId String
  scheduledById   String

  googleEventId   String?
  meetingLink     String?

  startsAt        DateTime
  endsAt          DateTime

  notes           String?

  status          VerificationCallStatus @default(SCHEDULED)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  scheduledBy     User          @relation("ScheduledVerificationCalls", fields: [scheduledById], references: [id])

  @@index([mentorProfileId])
  @@index([scheduledById])
  @@index([status])
  @@index([startsAt])
}

// ============================================================
// SESSION PACKAGES (multi-session bundles)
// ============================================================

enum PackagePurchaseStatus {
  PAYMENT_PENDING
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

/// A discounted bundle of sessions for one of a mentor's services.
model SessionPackage {
  id String @id @default(uuid())

  mentorProfileId String
  mentorServiceId String

  title       String
  description String?

  /// How many sessions the bundle contains (e.g. 5)
  sessionCount Int

  /// Total price for the whole bundle, in INR
  price Float

  /// Days the pack stays redeemable after purchase
  validityDays Int @default(180)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorService MentorService @relation(fields: [mentorServiceId], references: [id], onDelete: Cascade)

  purchases PackagePurchase[]

  @@index([mentorProfileId])
  @@index([mentorServiceId])
}

/// A mentee's purchase of a SessionPackage, tracking remaining redemptions.
model PackagePurchase {
  id String @id @default(uuid())

  packageId String
  menteeId  String

  sessionsTotal Int
  sessionsUsed  Int @default(0)

  amount Float

  razorpayOrderId   String?
  razorpayPaymentId String? @unique
  razorpaySignature String?

  status PackagePurchaseStatus @default(PAYMENT_PENDING)

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package SessionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  mentee  User           @relation("MenteePackagePurchases", fields: [menteeId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([menteeId])
  @@index([packageId])
  @@index([status])
}

// ============================================================
// MENTEE DOCUMENTS & PROFILE SHARING
// ============================================================

enum MenteeDocumentType {
  RESUME
  SOP
}

/// Named resumes/SOPs a mentee can keep on file and selectively share.
/// Resumes are universal; SOPs are college-specific.
model MenteeDocument {
  id String @id @default(uuid())

  menteeProfileId String

  type MenteeDocumentType

  /// Mentee-supplied label, e.g. "Consulting resume v3"
  name String

  fileUrl String

  /// Only meaningful for SOPs
  targetCollege String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menteeProfile MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)

  sharedOnBookings BookingSharedDocument[]

  @@index([menteeProfileId])
  @@index([menteeProfileId, type])
}

/// Which documents a mentee attached to a specific booking.
model BookingSharedDocument {
  id String @id @default(uuid())

  bookingId  String
  documentId String

  createdAt DateTime @default(now())

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  document MenteeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([bookingId, documentId])
  @@index([documentId])
}

// ============================================================
// WEBINARS
// ============================================================

enum WebinarStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum GroupRegistrationStatus {
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

model Webinar {
  id String @id @default(uuid())

  slug        String  @unique
  title       String
  description String
  coverImageUrl String?

  hostMentorProfileId String?

  startsAt DateTime
  endsAt   DateTime

  isPaid Boolean @default(false)
  price  Float   @default(0)

  /// Null means unlimited
  capacity Int?

  /// Video room channel (Agora) — shared by every confirmed registrant
  roomId String?

  status WebinarStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostMentorProfile MentorProfile? @relation(fields: [hostMentorProfileId], references: [id], onDelete: SetNull)

  registrations WebinarRegistration[]

  @@index([status])
  @@index([startsAt])
}

model WebinarRegistration {
  id String @id @default(uuid())

  webinarId String
  userId    String

  amount Float @default(0)

  razorpayOrderId   String?
  razorpayPaymentId String? @unique
  razorpaySignature String?

  status GroupRegistrationStatus @default(CONFIRMED)

  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User    @relation("WebinarRegistrations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
  @@index([userId])
}

// ============================================================
// GROUP DISCUSSIONS (GD / WAT practice)
// ============================================================

enum GroupDiscussionStatus {
  SCHEDULED
  CONFIRMED
  LIVE
  COMPLETED
  CANCELLED
}

model GroupDiscussion {
  id String @id @default(uuid())

  topic       String
  description String?

  moderatorMentorProfileId String?

  startsAt DateTime
  endsAt   DateTime

  /// The slot only runs once this many people have registered
  minParticipants Int @default(6)
  maxParticipants Int @default(12)

  price Float @default(0)

  roomId String?

  status GroupDiscussionStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderatorMentorProfile MentorProfile? @relation(fields: [moderatorMentorProfileId], references: [id], onDelete: SetNull)

  registrations GroupDiscussionRegistration[]

  @@index([status])
  @@index([startsAt])
}

model GroupDiscussionRegistration {
  id String @id @default(uuid())

  groupDiscussionId String
  userId            String

  amount Float @default(0)

  razorpayOrderId   String?
  razorpayPaymentId String? @unique
  razorpaySignature String?

  status GroupRegistrationStatus @default(CONFIRMED)

  /// Mentee opted to share their profile with the panel
  shareProfile Boolean @default(false)

  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupDiscussion GroupDiscussion @relation(fields: [groupDiscussionId], references: [id], onDelete: Cascade)
  user            User            @relation("GroupDiscussionRegistrations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupDiscussionId, userId])
  @@index([userId])
}

// ============================================================
// CONTENT: BLOG, FAQ, TESTIMONIALS
// ============================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id String @id @default(uuid())

  slug    String @unique
  title   String
  excerpt String?
  content String

  coverImageUrl String?

  tags String[]

  authorId String?

  status ContentStatus @default(DRAFT)

  readingMinutes Int @default(5)

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Faq {
  id String @id @default(uuid())

  question String
  answer   String

  category String @default("General")

  sortOrder Int @default(0)

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Testimonial {
  id String @id @default(uuid())

  authorName     String
  authorRole     String?
  authorImageUrl String?

  quote  String
  rating Int     @default(5)

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id String @id @default(uuid())

  userId String

  subject  String
  category String @default("General")

  status SupportTicketStatus @default(OPEN)

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("SupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

model SupportTicketMessage {
  id String @id @default(uuid())

  ticketId String
  authorId String

  body String

  /// True when written by an admin replying to the ticket
  isStaffReply Boolean @default(false)

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("SupportTicketMessages", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

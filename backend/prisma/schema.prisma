generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String?
  googleId       String?  @unique
  name           String?
  profilePicture String?
  provider       String   @default("local")
  role           Role     @default(MENTEE)
  isRoleSelected Boolean  @default(true)
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  menteeProfile  MenteeProfile?
  mentorProfile  MentorProfile?

  @@index([role])
  @@index([email])
}

model MenteeProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  dateOfBirth    DateTime @db.Date
  contactNumber  String
  education      Json     @default("[]") // Stores array of {type, institutionName, fromYear, toYear, score}
  otherMbaScore  Float?
  workExperience String?
  certifications String?
  catHistory     Json?    // Stores {LRDI, VARC, Quants} or similar
  resumeUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MentorProfile {
  id               String               @id @default(uuid())
  userId           String               @unique
  linkedInUrl      String?
  contactNumber    String
  bio              String
  expertiseTags      String[]
  servicesOffered    String[]
  servicePricing     Json?
  weeklyAvailability Json?
  ugCollegeProfile   String?
  pgProfile          String?
  workExperience     String?
  certifications     String?
  profilePhotoUrl    String?
  collegeDocumentUrl String?
  isVerified       Boolean              @default(false)
  approvalStatus   MentorApprovalStatus @default(PENDING)
  adminReviewNotes String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([approvalStatus])
}

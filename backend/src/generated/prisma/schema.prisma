generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  googleId String? @unique

  provider AuthProvider @default(LOCAL)

  role Role @default(MENTEE)

  name String

  profilePicture String?

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?

  menteeBookings Booking[] @relation("MenteeBookings")

  reviewsGiven Review[] @relation("ReviewAuthor")

  @@index([email])
  @@index([role])
}

// ============================================================
// MENTEE PROFILE
// ============================================================

model MenteeProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  dateOfBirth DateTime @db.Date

  contactNumber String

  education Json

  catHistory Json?

  otherMbaScore Float?

  workExperience String?

  certifications String?

  expectations String?

  skillsets String[]

  resumeUrl String?

  linkedInUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

// ============================================================
// MENTOR PROFILE
// ============================================================

model MentorProfile {
  id String @id @default(uuid())

  userId String @unique

  username String @unique

  bio String

  linkedInUrl String?

  contactNumber String

  expertiseTags String[]

  ugCollegeProfile String?

  pgCollegeProfile String?

  workExperience String?

  certifications String?

  collegeDocumentUrl String?

  approvalStatus MentorApprovalStatus @default(PENDING)

  isVerified Boolean @default(false)

  totalSessions Int @default(0)

  totalEarnings Float @default(0)

  averageRating Float @default(0)

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mentorServices      MentorService[]
  availabilityWindows AvailabilityWindow[]
  mentorBookings      Booking[]            @relation("MentorBookings")
  reviews             Review[]
  feedbacks           SessionFeedback[]
  payouts             Payout[]

  @@index([approvalStatus])
  @@index([averageRating])
  @@index([username])
}

// ============================================================
// MENTOR SERVICES
// ============================================================

/// Links a mentor to a service with pricing and duration config.
/// Supports both catalogue-based (serviceId set) and custom (title set) services.
model MentorService {
  id String @id @default(uuid())

  mentorProfileId String

  /// Custom service title (used when serviceId is null, or as override)
  title       String?
  /// Custom service description
  description String?

  /// Price in INR (₹50 – ₹2000)
  price           Float
  /// Session duration: 15, 30, 45, or 60 minutes
  durationMinutes Int
  /// Buffer between consecutive slots: 0, 5, 10, or 15 minutes
  bufferMinutes   Int     @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  windowServices AvailabilityWindowService[]
  bookings       Booking[]

  @@index([mentorProfileId])
}

// ============================================================
// AVAILABILITY WINDOWS (replaces WeeklyAvailability + AvailabilitySlot)
// ============================================================

/// A time range during which a mentor is available.
/// Can be recurring (dayOfWeek set, specificDate null) or
/// one-off (specificDate set, dayOfWeek null).
model AvailabilityWindow {
  id String @id @default(uuid())

  mentorProfileId String

  /// For recurring windows — e.g., every MONDAY
  dayOfWeek DayOfWeek?

  /// For one-off overrides — e.g., 2026-05-15
  specificDate DateTime? @db.Date

  /// Start time (stored as HH:mm in canonical 1970-01-01 UTC)
  startTime DateTime
  /// End time (stored as HH:mm in canonical 1970-01-01 UTC)
  endTime   DateTime

  /// IANA timezone (default IST)
  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile  MentorProfile               @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  windowServices AvailabilityWindowService[]

  @@index([mentorProfileId])
  @@index([mentorProfileId, dayOfWeek])
  @@index([mentorProfileId, specificDate])
}

// ============================================================
// AVAILABILITY WINDOW ↔ MENTOR SERVICE (join table)
// ============================================================

/// Which services are offered during a specific availability window.
model AvailabilityWindowService {
  id String @id @default(uuid())

  windowId        String
  mentorServiceId String

  createdAt DateTime @default(now())

  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  mentorService MentorService      @relation(fields: [mentorServiceId], references: [id], onDelete: Cascade)

  @@unique([windowId, mentorServiceId])
  @@index([mentorServiceId])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id String @id @default(uuid())

  menteeId        String
  mentorProfileId String
  mentorServiceId String

  /// Resolved UTC start/end — the actual booked time.
  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(PENDING)

  /// Razorpay payment ID (nullable — set on payment confirmation)
  paymentId String?

  meetingLink String?

  purposeOfCall String?

  notes String?

  cancelledReason String?

  rescheduledFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee        User          @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation("MentorBookings", fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorService MentorService @relation(fields: [mentorServiceId], references: [id])

  payment  Payment?
  review   Review?
  feedback SessionFeedback?

  @@index([menteeId])
  @@index([mentorProfileId])
  @@index([status])
  // Composite index for conflict-check queries
  @@index([mentorProfileId, startTime, endTime])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid())

  bookingId String @unique

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  amount Float

  currency String @default("INR")

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  refundedAmount Float?

  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoice Invoice?
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  paymentId String @unique

  invoiceNumber String @unique

  invoiceUrl String?

  generatedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================
// SESSION FEEDBACK
// ============================================================

model SessionFeedback {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  strengths String?

  weaknesses String?

  recommendations String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(uuid())

  bookingId String @unique

  mentorProfileId String

  authorId String

  rating Int

  review String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
}

// ============================================================
// PAYOUTS
// ============================================================

model Payout {
  id String @id @default(uuid())

  mentorProfileId String

  amount Float

  transactionId String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

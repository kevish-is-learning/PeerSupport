generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorServiceType {
  SOP_REVIEW
  RESUME_CURATION
  MOCK_INTERVIEW
  WAT_GD_PREP
  KNOW_YOUR_COLLEGE
  ONE_ON_ONE_CONNECT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String?
  googleId       String?        @unique
  name           String?
  profilePicture String?
  provider       String         @default("local")
  role           Role           @default(MENTEE)
  isRoleSelected Boolean        @default(true)
  isVerified     Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  menteeProfile  MenteeProfile?
  mentorProfile  MentorProfile?

  @@index([role])
  @@index([email])
}

model MenteeProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  dateOfBirth    DateTime @db.Date
  contactNumber  String
  education      Json     @default("[]") // Stores array of {type, institutionName, fromYear, toYear, score}
  otherMbaScore  Float?
  workExperience String?
  certifications String?
  catHistory     Json? // Stores {LRDI, VARC, Quants} or similar
  resumeUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MentorProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique
  linkedInUrl        String?
  contactNumber      String
  bio                String
  expertiseTags      String[]
  ugCollegeProfile   String?
  pgProfile          String?
  workExperience     String?
  certifications     String?
  profilePhotoUrl    String?
  collegeDocumentUrl String?
  isVerified         Boolean              @default(false)
  approvalStatus     MentorApprovalStatus @default(PENDING)
  adminReviewNotes   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     MentorService[]
  availability WeeklyAvailability[]

  @@index([userId])
  @@index([approvalStatus])
}

// ─── Dedicated model for each service a mentor offers ────────────────────────
model MentorService {
  id              String            @id @default(uuid())
  mentorProfileId String
  serviceType     MentorServiceType
  pricePerSession Float
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, serviceType])
  @@index([mentorProfileId])
}

// ─── Dedicated model for weekly availability per day ─────────────────────────
model WeeklyAvailability {
  id              String    @id @default(uuid())
  mentorProfileId String
  dayOfWeek       DayOfWeek
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  timeSlots     TimeSlot[]

  @@unique([mentorProfileId, dayOfWeek])
  @@index([mentorProfileId])
}

// ─── Individual time slot within a day's availability ────────────────────────
model TimeSlot {
  id                   String @id @default(uuid())
  weeklyAvailabilityId String
  startTime            String // "09:00" format (HH:mm)
  endTime              String // "10:00" format (HH:mm)

  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  @@index([weeklyAvailabilityId])
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // or "mysql", etc.
  url      = env("DATABASE_URL")
}

///////////////////////////
// ENUMS
///////////////////////////

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SessionMode {
  VIDEO
  AUDIO
  CHAT
}

enum SessionType {
  ONE_ON_ONE
  GROUP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebinarType {
  FREE
  PAID
}

///////////////////////////
// USER & AUTH
///////////////////////////

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String?
  googleId        String?  @unique
  name            String?
  profilePicture  String?
  provider        String   @default("local") // "local" or "google"
  role            Role     @default(MENTEE)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  mentorProfile   MentorProfile?
  menteeProfile   MenteeProfile?
  bookingsAsMentor Booking[] @relation("MentorBookings")
  bookingsAsMentee Booking[] @relation("MenteeBookings")
  notifications   Notification[]
  verification    VerificationDocument?
  webinarRegistrations WebinarRegistration[]

  @@index([role])
  @@index([email])
}

///////////////////////////
// MENTOR PROFILE
///////////////////////////

model MentorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  bio               String
  expertise         String[]
  certifications    String[]
  pricePerSession   Float
  rating            Float    @default(0)
  totalReviews      Int      @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBadge     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  slots             Slot[]
  feedbackGiven     MentorFeedback[]
  earnings          Earnings[]

  @@index([pricePerSession])
  @@index([rating])
}

///////////////////////////
// MENTEE PROFILE
///////////////////////////

model MenteeProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  dob             DateTime?
  education10th   String?
  education12th   String?
  bachelors       String?
  masters         String?
  workExperience  String?
  certifications  String[]
  catScore        Float?
  expectations    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  resumes         Resume[]
  sopDocuments    SOPDocument[]
}

///////////////////////////
// DOCUMENTS
///////////////////////////

model Resume {
  id          String   @id @default(uuid())
  menteeId    String
  name        String
  fileUrl     String
  createdAt   DateTime @default(now())

  mentee      MenteeProfile @relation(fields: [menteeId], references: [id])
}

model SOPDocument {
  id          String   @id @default(uuid())
  menteeId    String
  collegeName String
  fileUrl     String
  createdAt   DateTime @default(now())

  mentee      MenteeProfile @relation(fields: [menteeId], references: [id])
}

///////////////////////////
// SLOT MANAGEMENT
///////////////////////////

model Slot {
  id          String     @id @default(uuid())
  mentorId    String
  startTime   DateTime
  endTime     DateTime
  status      SlotStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mentor      MentorProfile @relation(fields: [mentorId], references: [id])
  booking     Booking?

  @@index([mentorId])
  @@index([startTime])
  @@unique([mentorId, startTime, endTime])
}

///////////////////////////
// BOOKING SYSTEM
///////////////////////////

model Booking {
  id            String        @id @default(uuid())
  mentorId      String
  menteeId      String
  slotId        String        @unique
  status        BookingStatus @default(PENDING)
  sessionMode   SessionMode
  sessionType   SessionType   @default(ONE_ON_ONE)
  purpose       String
  meetingLink   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  mentor        User          @relation("MentorBookings", fields: [mentorId], references: [id])
  mentee        User          @relation("MenteeBookings", fields: [menteeId], references: [id])
  slot          Slot          @relation(fields: [slotId], references: [id])
  payment       Payment?
  feedback      Review?

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

///////////////////////////
// PAYMENTS
///////////////////////////

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  razorpayOrderId  String        @unique
  razorpayPaymentId String?
  amount           Float
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking          Booking       @relation(fields: [bookingId], references: [id])
}

///////////////////////////
// REVIEWS & FEEDBACK
///////////////////////////

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model MentorFeedback {
  id          String   @id @default(uuid())
  mentorId    String
  bookingId   String   @unique
  feedbackPdfUrl String?
  createdAt   DateTime @default(now())

  mentor      MentorProfile @relation(fields: [mentorId], references: [id])
}

///////////////////////////
// EARNINGS TRACKING
///////////////////////////

model Earnings {
  id          String   @id @default(uuid())
  mentorId    String
  bookingId   String   @unique
  amount      Float
  createdAt   DateTime @default(now())

  mentor      MentorProfile @relation(fields: [mentorId], references: [id])
}

///////////////////////////
// WEBINARS
///////////////////////////

model Webinar {
  id          String       @id @default(uuid())
  title       String
  description String
  price       Float?
  type        WebinarType
  startTime   DateTime
  endTime     DateTime
  meetingLink String?
  createdAt   DateTime     @default(now())

  registrations WebinarRegistration[]
}

model WebinarRegistration {
  id          String   @id @default(uuid())
  webinarId   String
  userId      String
  paymentId   String?
  createdAt   DateTime @default(now())

  webinar     Webinar  @relation(fields: [webinarId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

///////////////////////////
// NOTIFICATIONS
///////////////////////////

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

///////////////////////////
// VERIFICATION DOCUMENTS
///////////////////////////

model VerificationDocument {
  id          String   @id @default(uuid())
  userId      String   @unique
  documentUrl String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}